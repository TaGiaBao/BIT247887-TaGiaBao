import java.util.*;

public class Bai2 {
    public static void main(String[] args) {
        List<String> cities = Arrays.asList("Hanoi", "Ho Chi Minh", "Da Nang", "Hue");

        // Sử dụng Lambda để so sánh độ dài (length)
        Collections.sort(cities, (s1, s2) -> s1.length() - s2.length());

        System.out.println("Danh sách sau khi sắp xếp: " + cities);
    }
}
