import java.util.*;

public class Bai6 {
    public static void main(String[] args) {
        List<Integer> numbers = Arrays.asList(1, 2, 3, 4, 5, 6);

        // Chain method xử lý trong 1 dòng
        int result = numbers.stream()
                .filter(n -> n % 2 == 0)      // Lọc số chẵn: 2, 4, 6
                .map(n -> n * n)             // Bình phương: 4, 16, 36
                .mapToInt(Integer::intValue) // Chuyển về kiểu int để tính tổng
                .sum();                      // Tổng: 56

        System.out.println("Tổng các kết quả: " + result);
    }
}
